                case Ds of '|'(1:P8_ 2:Dr) then case P8_ of '#'(1:K 2:V) then local D10_ in
                  {LT_ K Key D10_}
                  if D10_ then {CondGet Dr Key Default E3_}
                   else skip
                   end
                end
                 else skip
                 end
                 else skip
                 end
              end
              case Ds of '|'(1:P6_ 2:Dr) then case P6_ of '#'(1:K 2:V) then local D8_ in
                {GT_ K Key D8_}
                if D8_ then E3_ = Default
                 else case Ds of '|'(1:P8_ 2:Dr) then case P8_ of '#'(1:K 2:V) then local D10_ in
                  {LT_ K Key D10_}
                  if D10_ then {CondGet Dr Key Default E3_}
                   else skip
                   end
                end
                 else skip
                 end
                 else skip
                 end
                 end
              end
               else {F6 }
               end
               else {F6 }
               end
            end
             end
          end
           else {F4 }
           end
           else {F4 }
           end
        end
      end
      case Ds of nil() then E3_ = Default
       else {F3 }
       end
    end
  end
  Map = proc {$ Xs F E4_}
    local F4 in
      F4 = proc {$ }
        case Xs of '|'(1:X 2:Xr) then local E6_ E7_ in
          {F X E6_}
          {Map Xr F E7_}
          E4_ = '|'(1:E6_ 2:E7_)
        end
         else skip
         end
      end
      case Xs of nil() then E4_ = nil()
       else {F4 }
       end
    end
  end
  Domain = proc {$ Ds E5_}
    local E7_ in
      E7_ = proc {$ A8_ E8_}
        local K N9_ P10_ in
          P10_ = '#'(1:K 2:N9_)
          P10_ = A8_
          E8_ = K
        end
      end
      {Map Ds E7_ E5_}
    end
  end
end
local NewWrapper Wrap Unwrap NewStack Push Pop IsEmpty in
  NewWrapper = proc {$ Wrap Unwrap}
    local Key in
      {NewName Key}
      Wrap = proc {$ X E1_}
        E1_ = proc {$ K E2_}
          local E3_ in
            {EQ_ K Key E3_}
            if E3_ then E2_ = X
             else skip
             end
          end
        end
      end
      Unwrap = proc {$ W E2_}
        {W Key E2_}
      end
    end
  end
  {NewWrapper Wrap Unwrap}
  NewStack = proc {$ E1_}
    local E2_ in
      E2_ = nil()
      {Wrap E2_ E1_}
    end
  end
  Push = proc {$ S E E2_}
    local E3_ in
      local E5_ in
        {Unwrap S E5_}
        E3_ = '|'(1:E 2:E5_)
      end
      {Wrap E3_ E2_}
    end
  end
  Pop = proc {$ S E E3_}
    local E4_ in
      {Unwrap S E4_}
      case E4_ of '|'(1:X 2:S1) then E = X
      {Wrap S1 E3_}
       else skip
       end
    end
  end
  IsEmpty = proc {$ S E4_}
    local E5_ E6_ in
      {Unwrap S E5_}
      E6_ = nil()
      {EQ_ E5_ E6_ E4_}
    end
  end
end
